    "1. 新建快捷指令，添加“截屏”。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New fast command, add \"screening\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"screening\" コマンドを追加"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 新建快捷指令，添加“截屏”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 新建快捷指令，新增“截圖”。"
          }
        }
      }
    },
    "2. 添加“从图像提取文本”，输入为截屏。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add \" Extracting text from images \" and enter it as a screen cut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「画像からテキスト抽出」を追加し、画面カットとして入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 添加“从图像提取文本”，输入为截屏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 新增“從影象提取文字”，輸入為截圖。"
          }
        }
      }
    },
    "3. 添加“多币种账本”的“获取记账识别候选”。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the words “Acquiring a candidate for account recognition” to the words “multi-currency ledgers”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アカウント認識の候補を取得する」という単語を「マルチ通貨のレジャー」に追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 添加“多币种账本”的“获取记账识别候选”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 新增“多幣種賬本”的“獲取記賬識別候選”。"
          }
        }
      }
    },
    "4. 用“获取 URL 内容”把 OCR 文本和候选 JSON 发给你的识别 API。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The OCR text and the JSON candidate are sent to you for identification API with \"Retrieving URL Content\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCR テキストと JSON 候補が「URL コンテンツの取得」で識別 API に送信されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 用“获取 URL 内容”把 OCR 文本和候选 JSON 发给你的识别 API。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 用“獲取 URL 內容”把 OCR 文字和候選 JSON 發給你的識別 API。"
          }
        }
      }
    },
    "5. 添加“多币种账本”的“识别并记账”，传入 OCR 文本与 API 返回的 JSON。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the \"Recognition and Recording\" of the \"multi-currency ledger\" to the JSON returned from OCR text and API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OCR テキストと API から返された JSON に \"multi-currency ledger\" の \"Recognition and Recording\" を追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 添加“多币种账本”的“识别并记账”，传入 OCR 文本与 API 返回的 JSON。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 新增“多幣種賬本”的“識別並記賬”，傳入 OCR 文字與 API 返回的 JSON。"
          }
        }
      }
    },
    "6. 成功时让快捷指令震动；需要确认时 App 会打开确认页。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Vibration of the fast command when successful; App opens the confirmation page if confirmation is required."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 成功したときに高速コマンドの振動;確認が必要な場合は、確認画面を開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 成功时让快捷指令震动；需要确认时 App 会打开确认页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 成功時讓快捷指令震動；需要確認時 App 會開啟確認頁。"
          }
        }
      }
    },
