            "state" : "translated",
            "value" : "The target allocation will be used only for planning the use of funds and will not change the real wallet balance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲット割り当ては、資金の使用を計画するためにのみ使用され、実際のウォレット残高を変更しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
