{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "brand.error.unsupportedURL" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This bookkeeping link is not supported by OneTsu" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この記帳リンクは OneTsu ではサポートされていません" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这不是 OneTsu 支持的记账链接" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這不是 OneTsu 支援的記帳連結" } }
      }
    },
    "brand.intent.createDraft" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a draft with OneTsu parameters and confirm it in the app before recording it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu のパラメータで下書きを作成し、App で確認してから記録します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 OneTsu 的参数创建草稿，并在 App 中确认后入账。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 OneTsu 的參數建立草稿，並在 App 中確認後入帳。" } }
      }
    },
    "brand.locked" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu is locked" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu はロックされています" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu 已锁定" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu 已鎖定" } }
      }
    },
    "brand.shortcuts.candidates" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3. Add OneTsu’s “Get Recognition Candidates” action." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "3. OneTsu の「記帳認識候補を取得」アクションを追加します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3. 添加 OneTsu 的“获取记账识别候选”。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "3. 加入 OneTsu 的「取得記帳辨識候選項目」。" } }
      }
    },
    "brand.shortcuts.confirm" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "5. Add OneTsu’s “Recognize and Record” action, passing the OCR text and API response JSON." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "5. OneTsu の「認識して記帳」アクションを追加し、OCR テキストと API の JSON 応答を渡します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "5. 添加 OneTsu 的“识别并记账”，传入 OCR 文本与 API 返回的 JSON。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "5. 加入 OneTsu 的「辨識並記帳」，傳入 OCR 文字與 API 回傳的 JSON。" } }
      }
    },
    "launch.failure.restore" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore and retry" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元して再試行" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复并重试" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "還原並重試" } }
      }
    },
    "launch.failure.retry" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try again" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新尝试" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新嘗試" } }
      }
    },
    "launch.failure.snapshotHeader" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Migration snapshots" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "移行スナップショット" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "迁移快照" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移轉快照" } }
      }
    },
    "launch.failure.snapshotMessage" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can restore a protected snapshot created before a schema migration. The current database is never erased silently." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スキーマ移行前に作成された保護スナップショットを復元できます。現在のデータベースが通知なく消去されることはありません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你可以恢复 Schema 迁移前生成的受保护快照；当前数据库不会被静默清空。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你可以還原 Schema 移轉前建立的受保護快照；目前資料庫不會被靜默清除。" } }
      }
    },
    "launch.failure.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu couldn’t open your local ledger" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu でローカル帳簿を開けませんでした" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu 无法打开本地账本" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu 無法開啟本機帳本" } }
      }
    },
    "launch.preparing.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking your on-device ledger and recovery snapshots." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "端末内の帳簿と復元スナップショットを確認しています。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查本地账本与恢复快照。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查本機帳本與復原快照。" } }
      }
    },
    "launch.preparing.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing OneTsu" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "OneTsu を準備しています" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备 OneTsu" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在準備 OneTsu" } }
      }
    },
    "storage.onDeviceOnly" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stored only on this device" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この端末内にのみ保存" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅存储在本机" } },
