        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビュー番号と互換性; 現在の完全なスナップショットが回復する前に自動的に保存され、それが失敗したときに元のデータベースと添付ファイルディレクトリを復元することを確認します。"
          }
        },
        "zh-Hans" : {
